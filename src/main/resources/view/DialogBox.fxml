<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root type="javafx.scene.layout.HBox" alignment="TOP_RIGHT" spacing="10.0"
         styleClass="dialog-box" maxWidth="Infinity"
         xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
  <children>
    <Label fx:id="dialog" wrapText="true" styleClass="dialog-text" maxWidth="280.0"/>
    <Label fx:id="avatar" styleClass="avatar" minWidth="36.0" minHeight="36.0"
           maxWidth="36.0" maxHeight="36.0" alignment="CENTER"/>
  </children>
</fx:root>
